#!/usr/bin/env bash
# qm-shell: talk to the Quantum Moon Quickshell config over its IPC.
#   qm-shell <target> <function> [args...]
# Examples: qm-shell lock lock | qm-shell launcher toggle | qm-shell toast info "Hi" "msg"
# Exit status is non-zero when the shell is not running (qs returns an error).
set -euo pipefail
if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'
  echo "Targets: $(command -v qs >/dev/null && qs -c solanum ipc show 2>/dev/null | grep -E '^target' | awk '{print $2}' | tr '\n' ' ')"
  exit 0
fi
exec qs -c solanum ipc call "$@"
