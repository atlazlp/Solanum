#!/usr/bin/env bash
# qm-clip: open the clipboard history (shell launcher mode, fuzzel fallback).
#   qm-clip [--delete]
#   --delete  pick an entry to remove from the history instead of pasting it
set -euo pipefail
delete=0
for a in "$@"; do
  case "$a" in
    -h|--help) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --delete|-d) delete=1 ;;
    *) echo "qm-clip: unknown argument '$a'" >&2; exit 2 ;;
  esac
done
mode=clip; [[ "$delete" -eq 1 ]] && mode=clipDelete
if qs -c quantum-moon ipc call launcher open "$mode" >/dev/null 2>&1; then exit 0; fi

for t in cliphist fuzzel; do command -v "$t" >/dev/null 2>&1 || { echo "qm-clip: $t not installed and the shell is not running" >&2; exit 1; }; done
if [[ "$delete" -eq 1 ]]; then
  sel="$(cliphist list | fuzzel --dmenu -p 'delete clip > ')" || exit 0
  [[ -n "$sel" ]] && printf '%s\n' "$sel" | cliphist delete
else
  sel="$(cliphist list | fuzzel --dmenu -p 'clip > ')" || exit 0
  [[ -n "$sel" ]] && printf '%s\n' "$sel" | cliphist decode | wl-copy
fi
