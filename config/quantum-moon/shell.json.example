{
    "screens": {
        "roles": { "main": "DP-2", "left": "HDMI-A-1", "right": "DP-3" }
    },
    "modules": {
        "bar": ["main"],
        "dashboard": ["main", "right"],
        "sidebar": ["main"],
        "utilities": ["main", "right"],
        "launcher": ["*"],
        "quantumMoon": ["main"],
        "notifications": ["main"],
        "lock": { "fullUi": ["main"] },
        "hover": { "launcher": ["main", "right"] }
    },
    "appearance": {
        "fontScale": 1.0,
        "padding": { "scale": 1.0 },
        "transparency": { "enabled": false, "base": 1 }
    },
    "general": {
        "idle": {
            "inhibitWhenAudio": true,
            "lockedSleepAfter": 300,
            "timeouts": [
                { "timeout": 1800, "idleAction": "lock" },
                { "timeout": 2100, "idleAction": ["systemctl", "suspend"] }
            ]
        },
        "showOverFullscreen": true
    },
    "bar": {
        "height": 36,
        "entries": [
            { "id": "logo", "enabled": true },
            { "id": "workspaces", "enabled": true },
            { "id": "spacer", "enabled": true },
            { "id": "activeWindow", "enabled": true },
            { "id": "spacer", "enabled": true },
            { "id": "tray", "enabled": true },
            { "id": "clock", "enabled": true },
            { "id": "statusIcons", "enabled": true },
            { "id": "power", "enabled": true }
        ],
        "activeWindow": { "showOnHover": false },
        "popouts": { "statusIcons": true, "tray": true },
        "showOnHover": false,
        "status": {
            "showAudio": true,
            "showMicrophone": true,
            "showNetwork": true,
            "showWifi": false,
            "showBluetooth": false,
            "showBattery": false,
            "showVpn": true,
            "showGitWatcher": true,
            "showUpdates": true,
            "showGameMode": true,
            "showKvm": true,
            "showNightLight": true,
            "showIdleInhibitor": true
        },
        "tray": { "hiddenIcons": [], "iconSubs": [] },
        "workspaces": { "perMonitorWorkspaces": true, "shown": 10 }
    },
    "launcher": {
        "showOnHover": false,
        "maxShown": 8,
        "prefixes": { "apps": "", "windows": "w:", "clip": "c:", "emoji": ":", "calc": "=" },
        "favourites": [],
        "hidden": []
    },
    "notifs": {
        "actionOnClick": true,
        "defaultExpireTimeout": 5000,
        "expire": true
    },
    "shiplog": { "maxEntries": 500, "retentionDays": 30 },
    "session": {
        "commands": {
            "logout": ["qm-lock"],
            "lock": ["qm-lock"],
            "suspend": ["systemctl", "suspend"],
            "hibernate": ["systemctl", "hibernate"],
            "reboot": ["systemctl", "reboot"],
            "shutdown": ["systemctl", "poweroff"]
        },
        "icons": { "logout": "lock" }
    },
    "quantumMoon": { "enabled": true, "showOnHover": true, "shuffleOnIdle": true },
    "updates": { "interval": 1800 },
    "nightlight": { "temperature": 4500 },
    "gameMode": { "autoVpnOff": true, "pauseVideo": true },
    "utilities": {
        "toasts": { "configLoaded": false, "vpnChanged": true, "gameMode": true, "hotplug": true }
    },
    "dashboard": { "weather": { "location": "", "unit": "C" } },
    "qm": { "root": "" }
}
