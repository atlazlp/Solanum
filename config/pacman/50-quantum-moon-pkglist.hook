# /etc/pacman.d/hooks/50-quantum-moon-pkglist.hook
# Keeps package lists in /var/lib/quantum-moon/ after every transaction so a backup
# (qm-backup) always carries a reinstall list: pacman -S --needed - < pkglist-explicit.txt
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Writing package lists to /var/lib/quantum-moon/
When = PostTransaction
Exec = /bin/sh -c 'mkdir -p /var/lib/quantum-moon && pacman -Qqe > /var/lib/quantum-moon/pkglist-explicit.txt && pacman -Qqm > /var/lib/quantum-moon/pkglist-foreign.txt; pacman -Qq > /var/lib/quantum-moon/pkglist-all.txt; pacman -Qqen > /var/lib/quantum-moon/pkglist-explicit-native.txt'
