[Unit]
Description=Quantum Moon Quickshell shell (qs -c quantum-moon)
Documentation=https://github.com/atlazlp/Quantum-Moon
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/qs -c quantum-moon
ExecStopPost=-/usr/bin/rm -f %t/quantum-moon-resume-grace.until
Environment=QM_SHELL_IPC="qs -c quantum-moon ipc call"
Slice=session.slice
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
