[Unit]
Description=Quantum Moon Quickshell shell (qs -c solanum)
Documentation=https://github.com/atlazlp/Solanum
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/qs -c solanum
ExecStopPost=-/usr/bin/rm -f %t/solanum-resume-grace.until
Environment=QM_SHELL_IPC="qs -c solanum ipc call"
Slice=session.slice
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
