[Unit]
Description=Quantum Moon mpvpaper video wallpaper watcher
PartOf=graphical-session.target
After=graphical-session.target solanum-shell.service hyprpaper.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStartPre=%h/.local/bin/qm-apply --persisted
ExecStart=%h/.local/bin/qm-video-watch
Slice=session.slice
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
